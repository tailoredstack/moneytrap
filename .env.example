# Copy to .env and adjust. Values below match the local Docker setup in ops/docker-compose.yml.

# Postgres URL for the local dev stack, used by the redirect spike and its verify script.
DATABASE_URL=postgres://moneytrap:moneytrap@127.0.0.1:5433/moneytrap
# Redis URL for the local dev stack, used by the redirect spike and its verify script.
REDIS_URL=redis://127.0.0.1:6380
# Postgres URL for the integration tests that need a real database.
TEST_DATABASE_URL=postgres://moneytrap:moneytrap@127.0.0.1:5433/moneytrap
# Redis URL for the integration tests that need a real Redis.
TEST_REDIS_URL=redis://127.0.0.1:6380
# Host port the compose Postgres service publishes on 127.0.0.1. Defaults to 5433 when unset.
MONEYTRAP_PG_PORT=5433
# Host port the compose Redis service publishes on 127.0.0.1. Defaults to 6380 when unset.
MONEYTRAP_REDIS_PORT=6380

# Network credential encryption. Use a distinct 32-byte random key per ID, base64 encoded.
# Store real values in the deployment secret manager; these placeholders are not valid keys.
NETWORK_SECRET_ACTIVE_KEY_ID=replace-with-active-key-id
NETWORK_SECRET_KEYS='{"replace-with-active-key-id":"REPLACE_WITH_BASE64_32_BYTE_KEY"}'

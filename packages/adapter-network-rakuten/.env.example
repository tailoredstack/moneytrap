# Rakuten Advertising connector settings. Copy to .env and fill in; never commit a real value.
# The client ID and client secret come from an Application in the Rakuten developer portal. They are secrets: keep them
# in the environment or the secret store, and never write them into the repo, a PR, or Linear.
RAKUTEN_CLIENT_ID=
RAKUTEN_CLIENT_SECRET=
# The Rakuten account ID the access token is scoped to. It is sent as the token request's scope.
RAKUTEN_ACCOUNT_ID=
# Optional. Defaults to https://api.linksynergy.com. The public docs list no separate sandbox host.
RAKUTEN_API_BASE_URL=

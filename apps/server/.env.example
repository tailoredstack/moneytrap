# Copy to .env and adjust. Read at startup by apps/server/src/index.ts.

# Public base URL of this server. Better Auth builds its links from it. Required to serve.
BASE_URL=http://127.0.0.1:3000
# Better Auth secret. Required to serve. Replace with a random value, for example `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-random-secret
# Postgres URL. Required by --migrate and to serve.
DATABASE_URL=postgres://moneytrap:moneytrap@127.0.0.1:5433/moneytrap
# Redis URL for the rate limits, the route view cache, and the click queue. Required to serve.
REDIS_URL=redis://127.0.0.1:6380
# Port the server listens on. Defaults to 3000 when unset.
PORT=3000
# Address the server binds to. Defaults to 127.0.0.1 when unset.
HOST=127.0.0.1
# Comma-separated CIDRs of the proxies in front of this server, for example 10.0.0.0/8. Leave empty when no proxy sits in front.
AUTH_TRUSTED_PROXIES=

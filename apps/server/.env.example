# Copy to .env and adjust. Read at startup by apps/server/src/index.ts.

# Public base URL of this server. Better Auth builds its links from it. Required to serve.
BASE_URL=http://127.0.0.1:3000
# Better Auth secret. Required to serve. Replace with a random value, for example `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-random-secret
# Postgres URL. Required by --migrate and to serve.
DATABASE_URL=postgres://moneytrap:moneytrap@127.0.0.1:5433/moneytrap
# Redis URL for the rate limits, the route view cache, and the click queue. Required to serve.
REDIS_URL=redis://127.0.0.1:6380
# Port the server listens on. Defaults to 3000 when unset.
PORT=3000
# Address the server binds to. Defaults to 127.0.0.1 when unset.
HOST=127.0.0.1
# Comma-separated CIDRs of the proxies in front of this server, for example 10.0.0.0/8. Leave empty when no proxy sits in front.
AUTH_TRUSTED_PROXIES=
# Comma-separated full origins, besides BASE_URL, that Better Auth accepts on requests with a cookie, for example when the
# app is opened at localhost instead of 127.0.0.1. Each entry is scheme, host, and port only: no path, no trailing slash,
# no wildcard. Startup stops on an invalid entry. BASE_URL is always trusted.
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5190
# SMTP delivery for the verification, reset, and invitation emails. With SMTP_HOST unset, messages stay in memory and
# no link is delivered. The values below send to Mailpit from ops/docker-compose.yml; read the mail at http://127.0.0.1:8025.
SMTP_HOST=127.0.0.1
# Defaults to 1025 when unset.
SMTP_PORT=1025
# Sender address. Required when SMTP_HOST is set.
SMTP_FROM=Moneytrap <no-reply@moneytrap.test>

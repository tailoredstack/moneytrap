{
  "name": "moneytrap",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages scripts",
    "typecheck": "bun run --filter '*' typecheck",
    "check:docs": "bun scripts/check-docs.ts",
    "build:binary": "bun build --compile apps/server/src/index.ts --outfile dist/moneytrap"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "1.4.4",
    "dependency-cruiser": "^18.7.0",
    "typescript": "6.0.3",
    "yaml": "^2.9.1"
  }
}

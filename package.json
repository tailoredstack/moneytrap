{
  "name": "moneytrap",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "db:migrate": "bun apps/server/build.ts --manifest-only && bun apps/server/src/index.ts --migrate",
    "seed": "bun apps/server/src/seed.ts",
    "reconcile:ledger": "bun apps/server/src/worker/reconcile-ledger.ts",
    "dev": "bun run --parallel --filter @moneytrap/server --filter @moneytrap/web dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages scripts",
    "typecheck": "bun run --filter '*' typecheck",
    "check:docs": "bun scripts/check-docs.ts",
    "check:drift": "bun scripts/check-drift.ts",
    "check:ports": "bun run --cwd packages/test-kit check:ports",
    "build:binary": "bun apps/server/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "1.4.4",
    "dependency-cruiser": "^18.7.0",
    "typescript": "6.0.3",
    "yaml": "^2.9.1"
  }
}

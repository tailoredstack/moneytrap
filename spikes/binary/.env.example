# Copy to .env and adjust. Read by server.ts and spike.test.ts.

# Postgres URL for the compiled binary. Required by --migrate.
DATABASE_URL=postgres://moneytrap:moneytrap@127.0.0.1:5433/moneytrap
# Port the compiled binary listens on. Defaults to 3000 when unset.
PORT=3000
# Postgres URL the compiled-binary migration test runs against. The test is skipped when unset.
BINARY_SPIKE_DATABASE_URL=postgres://moneytrap:moneytrap@127.0.0.1:5433/moneytrap

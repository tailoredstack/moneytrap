# Copy to .env and adjust. The compat suite reads COMPAT_*; the compiled server reads the rest.

# Postgres URL the compat suite runs against. The suite is skipped when unset.
COMPAT_DATABASE_URL=postgres://moneytrap:moneytrap@127.0.0.1:5433/moneytrap
# Redis URL the compat suite runs against. Defaults to redis://127.0.0.1:6380 when unset.
COMPAT_REDIS_URL=redis://127.0.0.1:6380
# Postgres URL for the compiled server. Required.
DATABASE_URL=postgres://moneytrap:moneytrap@127.0.0.1:5433/moneytrap
# Redis URL for the compiled server. Defaults to redis://127.0.0.1:6380 when unset.
REDIS_URL=redis://127.0.0.1:6380
# Better Auth secret for the compiled server. Required. Replace with a random value, for example `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-random-secret
# Public base URL of the compiled server. Defaults to http://127.0.0.1:$PORT when unset.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Port the compiled server listens on. Defaults to 3000 when unset.
PORT=3000
# OTLP trace endpoint. Defaults to http://127.0.0.1:4318/v1/traces when unset. Leave this line commented out to keep the default.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Copy to .env and adjust. Read by src/index.ts; verify.ts sets these for the service it starts.

# Postgres URL. Defaults to the local compose database when unset.
DATABASE_URL=postgres://moneytrap:moneytrap@127.0.0.1:5433/moneytrap
# Redis URL. Defaults to the local compose Redis when unset.
REDIS_URL=redis://127.0.0.1:6380
# Port the service listens on. Defaults to 3006 when unset.
PORT=3006
# Artificial delay in milliseconds before each click write. Defaults to 0.
CLICK_WRITE_DELAY_MS=0
